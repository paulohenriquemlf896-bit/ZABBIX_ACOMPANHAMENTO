# Copie este arquivo para .env e preencha com valores reais.
# NUNCA versionar o .env (ja esta no .gitignore).

# Endpoint da API do Zabbix (ver contexto/infraestrutura.md)
ZBX_URL=http://192.168.11.12/zabbix/api_jsonrpc.php

# Token de API do Zabbix (gerar em Usuarios > Tokens de API)
ZBX_TOKEN=

# --- Painel web (src/web/app.py) ---
# PAINEL_SECRET_KEY e OBRIGATORIA (assina o cookie de sessao do login).
# Gere um valor aleatorio, ex.: python -c "import secrets; print(secrets.token_hex(32))"
PAINEL_SECRET_KEY=
# PAINEL_HOST e PAINEL_PORT sao opcionais (ja tem default seguro)
# PAINEL_HOST=127.0.0.1
# PAINEL_PORT=8080

# --- Variaveis futuras (prompts/tarefas/notificacoes.txt), preencher quando implementadas ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USUARIO=
# SMTP_SENHA=
