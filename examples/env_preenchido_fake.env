# Exemplo de .env PREENCHIDO com valores FICTICIOS, so para ilustrar o
# formato esperado. NUNCA copiar valores daqui para o .env real, e
# NUNCA colocar um token de verdade num arquivo de exemplo (ver
# prompts/politicas/seguranca.txt).

ZBX_URL=http://192.168.11.12/zabbix/api_jsonrpc.php
ZBX_TOKEN=exemplo_fake_1a2b3c4d5e6f7890_nao_e_um_token_real

# Variaveis futuras (specs/notificacoes.md), formato ilustrativo:
SMTP_HOST=smtp.exemplo.com.br
SMTP_PORT=587
SMTP_USUARIO=relatorios@exemplo.com.br
SMTP_SENHA=exemplo_fake_nao_use_isso
